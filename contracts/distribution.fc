#include "imports/stdlib.fc";
#include "imports/constants.fc";
#include "imports/jetton-utils.fc";

(slice, int, cell, cell) load_data() inline {
    var ds = get_data().begin_parse();
    return (
        ds~load_msg_addr(), ;; admin
        ds~load_coins(),    ;; total_distributed
        ds~load_dict(),     ;; user_rewards
        ds~load_dict()      ;; claimed_amounts
    );
}

save_data(slice admin, int total_distributed, cell user_rewards, cell claimed_amounts) impure inline {
    set_data(begin_cell()
        .store_slice(admin)
        .store_coins(total_distributed)
        .store_dict(user_rewards)
        .store_dict(claimed_amounts)
        .end_cell());
}

() recv_internal(int balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) {
        return ();
    }

    int op = in_msg_body~load_uint(32);
    int query_id = in_msg_body~load_uint(64);

    var (admin, total_distributed, user_rewards, claimed_amounts) = load_data();

    if (op == op::add_reward()) {
        throw_unless(401, equal_slices(sender_address(), admin));
        
        slice user = in_msg_body~load_msg_addr();
        int amount = in_msg_body~load_coins();
        
        user_rewards = user_rewards~udict_replace_builder?(267, user, begin_cell().store_coins(amount).end_cell().begin_parse());
        
        total_distributed += amount;
        save_data(admin, total_distributed, user_rewards, claimed_amounts);
        return ();
    }

    if (op == op::claim_reward()) {
        slice user = sender_address();
        
        var (reward_cs, found?) = user_rewards.udict_get?(267, user);
        throw_unless(404, found?);
        
        int reward_amount = reward_cs~load_coins();
        
        var (claimed_cs, claimed_found?) = claimed_amounts.udict_get?(267, user);
        int claimed = claimed_found? ? claimed_cs~load_coins() : 0;
        
        int claimable = reward_amount - claimed;
        throw_unless(402, claimable > 0);
        throw_unless(403, balance >= claimable + min_tons_for_storage());
        
        claimed_amounts = claimed_amounts~udict_replace_builder?(267, user, begin_cell().store_coins(claimed + claimable).end_cell().begin_parse());
        save_data(admin, total_distributed, user_rewards, claimed_amounts);
        
        send_raw_message(begin_cell()
            .store_uint(0x18, 6)
            .store_slice(user)
            .store_coins(claimable)
            .store_uint(0, 107)
            .end_cell(), 64);
        
        return ();
    }

    if (op == op::distribute_weekly()) {
        throw_unless(401, equal_slices(sender_address(), admin));
        
        int distribution_amount = in_msg_body~load_coins();
        
        send_raw_message(begin_cell()
            .store_uint(0x18, 6)
            .store_slice(admin)
            .store_coins(distribution_amount)
            .store_uint(0, 107)
            .end_cell(), 64);
        
        return ();
    }

    throw(0xffff);
}

() recv_external(slice in_msg) impure {
}

int get_user_reward(slice user) method_id {
    var (_, _, user_rewards, claimed_amounts) = load_data();
    
    var (reward_cs, found?) = user_rewards.udict_get?(267, user);
    if (~found?) {
        return 0;
    }
    
    int reward_amount = reward_cs~load_coins();
    
    var (claimed_cs, claimed_found?) = claimed_amounts.udict_get?(267, user);
    int claimed = claimed_found? ? claimed_cs~load_coins() : 0;
    
    return reward_amount - claimed;
}

(int, int) get_total_stats() method_id {
    var (_, total_distributed, _, claimed_amounts) = load_data();
    return (total_distributed, total_distributed);
}
