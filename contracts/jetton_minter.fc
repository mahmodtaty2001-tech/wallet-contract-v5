#include "imports/stdlib.fc";
#include "imports/constants.fc";
#include "imports/jetton-utils.fc";

;
; Jetton Minter - عملة محمود
; Mahmoud Token Smart Contract
;

(int, slice, cell, cell) load_data() inline {
    var ds = get_data().begin_parse();
    return (
        ds~load_coins(),     ;; total_supply
        ds~load_msg_addr(),  ;; admin
        ds~load_ref(),       ;; content (metadata)
        ds~load_ref()        ;; jetton_wallet_code
    );
}

save_data(int total_supply, slice admin, cell content, cell jetton_wallet_code) impure inline {
    set_data(begin_cell()
        .store_coins(total_supply)
        .store_slice(admin)
        .store_ref(content)
        .store_ref(jetton_wallet_code)
        .end_cell());
}

() recv_internal(int balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) {
        return ();
    }

    int op = in_msg_body~load_uint(32);
    int query_id = in_msg_body~load_uint(64);

    var (total_supply, admin, content, jetton_wallet_code) = load_data();

    if (op == op::mint()) {
        throw_unless(401, equal_slices(sender_address(), admin));
        
        slice to = in_msg_body~load_msg_addr();
        int amount = in_msg_body~load_coins();
        int deploy_amount = in_msg_body~load_coins();

        total_supply += amount;

        cell state_init = calculate_jetton_wallet_state_init(to, my_address(), jetton_wallet_code);
        slice wallet_address = calc_address(state_init);

        send_raw_message(begin_cell()
            .store_uint(0x18, 6)
            .store_slice(wallet_address)
            .store_coins(deploy_amount)
            .store_uint(4 + 2 + 1, 1 + 4 + 4 + 64 + 32 + 1 + 1 + 1)
            .store_ref(state_init)
            .store_ref(begin_cell()
                .store_uint(op::internal_transfer(), 32)
                .store_uint(query_id, 64)
                .store_coins(amount)
                .store_slice(my_address())
                .store_slice(my_address())
                .store_coins(0)
                .store_uint(0, 1)
                .end_cell())
            .end_cell(), 64);

        save_data(total_supply, admin, content, jetton_wallet_code);
        return ();
    }

    if (op == op::burn_notification()) {
        int amount = in_msg_body~load_coins();
        total_supply -= amount;
        save_data(total_supply, admin, content, jetton_wallet_code);
        return ();
    }

    throw(0xffff);
}

int get_jetton_data() method_id {
    var (total_supply, admin, content, _) = load_data();
    return (total_supply, -1, admin, content, jetton_wallet_code);
}

slice get_wallet_address(slice owner) method_id {
    var (_, _, _, jetton_wallet_code) = load_data();
    return calc_address(calculate_jetton_wallet_state_init(owner, my_address(), jetton_wallet_code));
}
